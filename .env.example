# ─────────────────────────────────────────────────────────────────────────────
# Singular Agency – Odoo MCP Server – Environment Variables
# Copy this file to .env and fill in your values.
# In Hostinger Easy Deploy, set these directly in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Odoo connection (REQUIRED) ───────────────────────────────────────────────
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-admin@example.com
ODOO_API_KEY=your-odoo-api-key-here

# ── MCP server auth (REQUIRED for centralized deployment) ───────────────────
# This is the secret key Claude/Cowork uses to authenticate with this server,
# via ?key=VALUE, X-API-Key, or Authorization: Bearer.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-to-a-strong-random-secret

# ── OAuth (REQUIRED for clients that only support OAuth, e.g. Hyperagent) ───
# The server acts as its own OAuth 2.1 authorization server. No external
# identity provider is involved, and Odoo credentials are not part of this —
# OAuth only governs how a client proves it may talk to this server.
MCP_OAUTH_ENABLED=true

# Public HTTPS base URL, no trailing slash. Set this explicitly: OAuth requires
# the issuer to match exactly, and behind a reverse proxy the request URL is the
# internal one.
MCP_PUBLIC_URL=https://your-mcp-domain.com

# The secret a human types once into the consent screen. Keep it separate from
# MCP_API_KEY so the long-lived programmatic key never gets pasted into a
# browser form. Falls back to MCP_API_KEY if unset.
MCP_OAUTH_PASSWORD=change-me-to-a-different-strong-secret

# Signs the access/refresh tokens. Rotating it invalidates every issued token,
# which is the only way to revoke one — there is no per-token revocation.
# Falls back to a value derived from MCP_OAUTH_PASSWORD if unset.
MCP_OAUTH_SECRET=change-me-to-another-strong-random-secret

# Redirect-URI allowlist — the control that actually protects the flow. Without
# it, anyone could register a client pointing at their own callback and phish an
# operator into approving it (PKCE does not help there). Comma-separated;
# entries may be exact URLs or https://host/* to allow any path on that host.
# Defaults to the Claude callbacks below when unset. To find a new client's
# callback, attempt the connection once and read the rejected URI from the logs.
MCP_OAUTH_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Allow http://localhost and http://127.0.0.1 callbacks (MCP Inspector, local
# testing). Keep this false in production.
MCP_OAUTH_ALLOW_LOCALHOST=false

# Token lifetimes in seconds. Access tokens default to 30 days; lower this if
# your client refreshes reliably, since a shorter window limits the damage from
# a leaked token.
MCP_OAUTH_ACCESS_TTL=2592000
MCP_OAUTH_REFRESH_TTL=31536000

# Trust X-Forwarded-For/Proto/Host. Correct behind Hostinger/Traefik/nginx;
# set to false only if this server is exposed directly to the internet.
MCP_TRUST_PROXY_HEADERS=true

# ── MCP server tuning (optional, defaults shown) ────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_DEBUG=false
MCP_LOG_LEVEL=INFO

# ── Cache (optional, defaults shown) ────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000
