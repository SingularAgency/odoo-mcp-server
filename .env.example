# ─────────────────────────────────────────────────────────────────────────────
# Singular Agency – Odoo MCP Server – Environment Variables
# Copy this file to .env and fill in your values.
# In Hostinger Easy Deploy, set these directly in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Odoo connection (REQUIRED) ───────────────────────────────────────────────
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-admin@example.com
ODOO_API_KEY=your-odoo-api-key-here

# ── MCP server auth (REQUIRED for centralized deployment) ───────────────────
# This is the secret key Claude/Cowork uses to authenticate with this server,
# via ?key=VALUE, X-API-Key, or Authorization: Bearer.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-to-a-strong-random-secret

# ── OAuth (only for clients that require it, e.g. Hyperagent) ───────────────
# The server acts as its own OAuth 2.1 authorization server. No external
# identity provider is involved, and Odoo credentials are not part of this —
# OAuth only governs how a client proves it may talk to this server.
# It activates automatically once MCP_API_KEY (above) is set.
#
# Two variables. Everything else is a fixed, sane default.

# 1. Public HTTPS base URL, no trailing slash. OAuth requires the issuer to
#    match exactly, and behind a reverse proxy the request URL is the internal
#    one. If omitted, it is derived from the proxy's X-Forwarded-* headers.
MCP_PUBLIC_URL=https://your-mcp-domain.com

# 2. Redirect-URI allowlist — the control that actually protects the flow.
#    Without it, anyone could register a client pointing at their own callback
#    and phish an operator into approving it (PKCE does not help there).
#    Comma-separated; entries are exact URLs, or https://host/* for any path on
#    that host. Defaults to the Claude callbacks when unset.
#    To find a client's callback: attempt the connection once, then read the
#    rejected URI from the server logs.
MCP_OAUTH_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback

# Optional. The secret typed into the consent screen; falls back to MCP_API_KEY.
# Setting it separately means the long-lived programmatic key never has to be
# pasted into a browser form. Rotating it invalidates every issued token.
# MCP_OAUTH_PASSWORD=change-me-to-a-different-strong-secret

# ── MCP server tuning (optional, defaults shown) ────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_DEBUG=false
MCP_LOG_LEVEL=INFO

# ── Cache (optional, defaults shown) ────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000
